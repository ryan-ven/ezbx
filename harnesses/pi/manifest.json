{
  "schema": 1,
  "id": "pi",
  "name": "Pi",
  "kind": "coding",

  "install": {
    "type": "npm",
    "package": "@earendil-works/pi-coding-agent",
    "version": "1.5.0",
    "script": "install.sh",
    "lockfile": "package-lock.json"
  },

  "binary": "pi",
  "runtime": "node",

  "env": {
    "PI_SKIP_VERSION_CHECK": "1"
  },

  "config": [
    {
      "path": "~/.pi/agent/models.json",
      "mode": "0600",
      "content": {
        "providers": {
          "ezbx": {
            "baseUrl": "${gateway.baseUrl}",
            "api": "openai-completions",
            "apiKey": "${gateway.key}",
            "compat": {
              "supportsDeveloperRole": false,
              "supportsReasoningEffort": false
            },
            "models": {
              "$each": "models",
              "as": {
                "id": "${id}",
                "name": "${name}",
                "reasoning": "${reasoning}",
                "input": "${input}",
                "contextWindow": "${contextWindow}",
                "maxTokens": "${maxTokens}",
                "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 }
              }
            }
          }
        }
      }
    },
    {
      "path": "~/.pi/agent/settings.json",
      "mode": "0600",
      "content": {
        "defaultProvider": "ezbx",
        "defaultModel": "${models.default.id}",
        "defaultThinkingLevel": "medium"
      }
    }
  ],

  "launch": {
    "command": ["pi"],
    "cwd": "/workspace"
  },

  "autonomy": {
    "flag": null,
    "note": "No approval-skipping flag is recorded yet. Check Pi's current documentation before adding one."
  },

  "network": {
    "domains": [],
    "optional": {
      "github-mcp": ["api.githubcopilot.com"]
    }
  },

  "secrets": [],

  "verified": {
    "version": "1.5.0",
    "status": "verified",
    "observedOn": "2026-11-20",
    "reverify": false,
    "notes": "Installed from the lockfile with install scripts off, in the first EZBox box image. pi -p answered through the gateway on the isolated network, using a fake engine. Not yet checked: a real model, tool calls, the interactive interface."
  }
}
